# ── Server ───────────────────────────────────────────────────────────────────
# Port the API listens on (Render sets PORT automatically)
PORT=5000

# Comma-separated list of allowed CORS origins, or * for all.
# Example: https://limitlessworld.net,https://www.limitlessworld.net
ALLOWED_ORIGINS=*

# Public URL of THIS backend once deployed (used to build public PDF links).
# Example: https://limitless-backend.onrender.com
PUBLIC_BASE_URL=

# ── MongoDB (REQUIRED for auth/users/assessments/admin/files) ────────────────
# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=limitless

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string used to sign JWTs. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin panel credentials (defaults match the current frontend — CHANGE THEM!)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@limitlessworld.net
ADMIN_PASSWORD=limitlessadmin

# ── AI question generation (OPTIONAL) ────────────────────────────────────────
# If set, questions and report insights are personalized by Claude.
# If missing or the AI call fails, the backend falls back to its built-in
# question bank — the API never errors because of this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Stripe webhook (OPTIONAL but recommended for production) ─────────────────
# Signing secret of the webhook endpoint (whsec_...). When configured, Stripe
# notifies POST /api/v1/webhooks/stripe on successful payment and the backend
# marks the user as paid in MongoDB server-side (tamper-proof).
STRIPE_WEBHOOK_SECRET=

# ── Backend email via SMTP (OPTIONAL — replaces EmailJS) ─────────────────────
# Example for Gmail: smtp.gmail.com / 587 / an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Where "new registration" notifications are sent (replaces formsubmit.co)
ADMIN_NOTIFY_EMAIL=
# Used in email links back to your site, e.g. https://limitlessworld.net
FRONTEND_URL=
